# DeepSeek API (OpenAI-compatible). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional overrides
# DeepSeek base URL (OpenAI-compatible). Default: https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model id. DeepSeek's fast/non-reasoner model is "deepseek-chat".
# Set to your preferred id (e.g. deepseek-reasoner) if needed.
DEEPSEEK_MODEL=deepseek-chat

# Server port
PORT=3000
